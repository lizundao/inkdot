---
/** 全站页脚。备案号、联系方式改这里 → 全站同步。
 *  工具链接由 apps.ts 自动生成：新增工具后无需再改本文件。 */
import { site } from '../data/site';
import { liveApps } from '../data/apps';
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <img src="/assets/img/inkdot.png" alt="" width="48" height="48" loading="lazy" />
      <div>
        <div class="footer-brand-name">{site.name}<span style="color:var(--seal)">.</span></div>
        <div class="footer-brand-slogan">{site.slogan}</div>
      </div>
    </div>
    <nav class="footer-links" aria-label="页脚导航">
      {liveApps.map((a) => <a href={a.url}>{a.name}</a>)}
      <a href="/changelog/">更新记录</a>
      <a href={site.authorUrl} target="_blank" rel="noopener">关于作者</a>
      <a href={`mailto:${site.email}`}>联系我</a>
      <a href="/legal/privacy/">隐私政策</a>
      <a href="/legal/disclaimer/">免责声明</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <span>© {site.year} {site.name} {site.en} · 小工具，一点就够用</span>
      <span>
        <a href={site.icpUrl} target="_blank" rel="noopener">{site.icp}</a>
        <span style="margin: 0 8px; opacity:.5">·</span>
        依据 MIT 许可开放源码
      </span>
    </div>
  </div>
</footer>
