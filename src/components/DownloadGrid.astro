---
/** 下载卡片区（详情页）。下载链接集中来自数据层，改一处全站同步。 */
import type { App } from '../data/apps';
import Icon from './Icon.astro';
interface Props { app: App; }
const { app } = Astro.props;
const osShort = (os: string) => (os === 'Windows' ? 'WIN' : os === 'macOS' ? 'MAC' : 'PAN');
---
<div>
  <div class="download-grid">
    {app.downloads.map((d) => (
      <a class="download-card" href={d.url} {...(d.external ? { target: '_blank' } : { download: true })} rel="noopener">
        <span class="dl-icon">{osShort(d.os)}</span>
        <span class="dl-body">
          <span class="dl-label">{d.label}</span>
          <span class="dl-note">{d.note}</span>
          {d.code && <span class="dl-code" data-code={d.code} title="链接已自动填入提取码；若未生效可点此复制备用">提取码 <b>{d.code}</b> <span class="dl-copy">已填 · 复制</span></span>}
        </span>
        <span class="dl-arrow"><Icon name={d.external ? 'external' : 'download'} /></span>
      </a>
    ))}
  </div>
  <p class="dl-hint">
    <Icon name="info" />
    <span>未签名软件首次运行可能被系统提示拦截（Windows SmartScreen / macOS Gatekeeper），属正常现象，详见页面下方「常见问题」与仓库文档。已开源，源码可自行审查。</span>
  </p>
</div>
