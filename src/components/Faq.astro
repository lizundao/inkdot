---
/** FAQ 折叠列表。点击展开由 BaseLayout 的全站脚本统一处理。 */
import type { Faq } from '../data/apps';
interface Props { items: Faq[]; }
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((item) => (
    <div class="faq-item">
      <button class="faq-q" type="button" aria-expanded="false">
        <span class="q-mark">问</span>
        <span>{item.q}</span>
        <span class="plus">+</span>
      </button>
      <div class="faq-a">
        <div class="faq-a-inner">{item.a}</div>
      </div>
    </div>
  ))}
</div>
