---
/** 全站页头。改这里 → 所有页面导航同步更新。
 *  导航只保留「首页 / 工具」两项：全部工具已在首页 #apps 聚合区列出，
 *  不必在导航栏逐个罗列（避免工具变多后导航换行拥挤）。 */
import { site } from '../data/site';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
const links = [
  { key: 'home', href: '/', label: '首页', active: pathname === '/' },
  { key: 'tools', href: '/#apps', label: '工具', active: pathname.startsWith('/apps') },
  { key: 'log', href: '/changelog/', label: '更新记录', active: pathname.startsWith('/changelog') },
];
---
<header class="site-header">
  <div class="container nav">
    <a href="/" class="brand" aria-label={`${site.name}${site.en} 首页`}>
      <span class="brand-mark"><img src="/assets/img/inkdot.png" alt="" width="38" height="38" /></span>
      <span class="brand-name">{site.name}<span style="color:var(--seal)">.</span></span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: l.active }]}>{l.label}</a>
      ))}
      <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深浅主题" title="切换深浅主题">
        <Icon name="moon" class="icon-moon" />
        <Icon name="sun" class="icon-sun" />
      </button>
    </nav>
  </div>
</header>
