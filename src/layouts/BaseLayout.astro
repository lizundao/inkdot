---
/** 全站唯一骨架：页头、页脚、SEO、主题、全站交互集中于此。
 *  改页头/页脚 → 改 SiteHeader / SiteFooter 组件即可，所有页面同步。 */
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../data/site';
import { getApp } from '../data/apps';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'pdf' | 'image' | 'finance' | 'batch' | 'meta' | 'seal' | 'tixingmao' | 'rili' | 'privacy' | 'disclaimer';
  ogImage?: string;
  /** 传工具 id 时输出 SoftwareApplication 结构化数据（详情页/教程页用） */
  appId?: string;
}
const {
  title,
  description = site.description,
  active,
  ogImage = '/assets/img/pdf-toolbox-cover.png',
  appId,
} = Astro.props;

const fullTitle = `${title} · ${site.name} ${site.en}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

/** 读 PNG 的 IHDR 拿宽高，给 og:image 补尺寸（社交平台首图按比例裁切需要）。 */
function pngSize(urlPath: string): { w: number; h: number } | null {
  try {
    const file = path.join(process.cwd(), 'public', urlPath.replace(/^\//, ''));
    const fd = fs.openSync(file, 'r');
    const buf = Buffer.alloc(26);
    fs.readSync(fd, buf, 0, 26, 0);
    fs.closeSync(fd);
    if (buf.subarray(0, 8).toString('hex') !== '89504e470d0a1a0a') return null;
    return { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) };
  } catch {
    return null;
  }
}
const ogSize = pngSize(ogImage);

const app = appId ? getApp(appId) : undefined;

/** 结构化数据：站点 + （可选）工具。搜索引擎据此识别这是软件下载页。 */
const ld: unknown[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${site.name} ${site.en}`,
    alternateName: site.en,
    url: site.url,
    description: site.description,
    inLanguage: 'zh-CN',
  },
];
if (app) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: app.name,
    description: app.description,
    url: new URL(app.url, site.url).href,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: app.platforms.join(', '),
    softwareVersion: app.version,
    datePublished: app.updated,
    image: new URL(app.icon, site.url).href,
    inLanguage: 'zh-CN',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY', availability: 'https://schema.org/InStock' },
    publisher: { '@type': 'Organization', name: `${site.name} ${site.en}`, url: site.url },
  });
}
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name} ${site.en}`} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {ogSize && <meta property="og:image:width" content={String(ogSize.w)} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize.h)} />}
    <meta property="og:image:alt" content={app ? `${app.name} 界面预览` : `${site.name} ${site.en}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- 霞鹜文楷分片字体（按 unicode-range 按需加载，通常仅几十 KB） -->
    <link rel="stylesheet" href="/assets/fonts/lxgw/font.css" />
    <link rel="stylesheet" href="/assets/css/style.css" />

    <!-- 主题脚本必须在首屏绘制前同步执行，避免深浅色闪烁（FOUC） -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('inkdot-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <SiteHeader active={active} />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- 全站交互：主题切换、FAQ 折叠、教程侧栏滚动高亮 -->
    <script>
      // 主题切换
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('inkdot-theme', next); } catch (e) {}
      });

      // FAQ 折叠
      document.querySelectorAll('.faq-q').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.faq-item');
          var open = item && item.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });

      // 百度网盘提取码：点击复制（不触发外层链接跳转）
      document.querySelectorAll('.dl-code').forEach(function (el) {
        el.addEventListener('click', function (ev) {
          ev.preventDefault();
          ev.stopPropagation();
          var code = el.getAttribute('data-code') || '';
          var done = function () {
            var tip = el.querySelector('.dl-copy');
            if (tip) { tip.textContent = '已复制'; }
            setTimeout(function () { if (tip) { tip.textContent = '复制'; } }, 1600);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(done).catch(function () {});
          } else {
            var ta = document.createElement('textarea');
            ta.value = code; document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); done(); } catch (e) {}
            document.body.removeChild(ta);
          }
        });
      });

      // 教程页侧栏：滚动高亮当前小节
      var links = Array.prototype.slice.call(document.querySelectorAll('.side-nav a[href^="#"]'));
      var targets = links
        .map(function (a) { return document.querySelector(a.getAttribute('href')); })
        .filter(Boolean);
      if (targets.length && 'IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            links.forEach(function (a) {
              a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id);
            });
          });
        }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });
        targets.forEach(function (t) { obs.observe(t); });
      }
    </script>
  </body>
</html>
